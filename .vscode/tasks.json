{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start FastAPI Server",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
